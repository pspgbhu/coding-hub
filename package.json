{
  "name": "coding-hub",
  "version": "0.1.1",
  "description": "A local-first desktop workspace for your coding agents",
  "main": "./out/main/index.js",
  "author": "Coding Hub contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "rebuild": "electron-builder install-app-deps",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.236",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/sdk": "1.19.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "13.0.3",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
